# Hermes container runtime environment. Secrets for the agent itself stay in the
# mounted ~/.hermes/.env (the container loads it from /opt/data/.env automatically).
# This file only holds container-runtime knobs. Create once before `docker compose up`.

# Container runtime user — must match the host user that owns ~/.hermes
# (and the ~/repos mount). The migrating box: coder = UID 1000 / GID 1000.
# Check with `id` on the new host and adjust.
PUID=1000
PGID=1000

TZ=UTC

# Dashboard auth — REQUIRED: the dashboard binds 0.0.0.0 inside the container and
# the image fails closed at startup without an auth provider on a non-loopback bind.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Restart-stable session secret — generate once and keep:
#   openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
