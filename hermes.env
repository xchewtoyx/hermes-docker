# Hermes container runtime environment. Secrets for the agent itself stay in the
# persistent Hermes volume at /opt/data/.env and are loaded automatically.
# This file only holds container-runtime knobs. Edit it before `docker compose up`.

# Docker-managed volumes do not need host UID/GID alignment. When using the
# migration overlay with bind mounts, uncomment these and set them to the host
# user that owns ~/.hermes and ~/repos (`id -u` / `id -g`).
# PUID=1000
# PGID=1000

TZ=UTC

# Dashboard auth — REQUIRED: the dashboard binds 0.0.0.0 inside the container and
# the image fails closed at startup without an auth provider on a non-loopback bind.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Restart-stable session secret — generate once and keep:
#   openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

# GUI image only. The headless image safely ignores these values.
GUI_SCREEN=1440x900x24
ENABLE_NOVNC=1
